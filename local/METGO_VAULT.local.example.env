# =============================================================================
# METGO — vault local de accesos (SOLO EN ESTE PC)
# =============================================================================
# 1. Copiar este archivo a:  local/METGO_VAULT.local.env
# 2. Rellenar valores reales (nunca commitear METGO_VAULT.local.*)
# 3. Para llevar a otro PC:  python scripts/ops/vault_crypto.py pack
#    Luego en el otro PC:    python scripts/ops/vault_crypto.py unpack
# Guía: docs/ops/BOOTSTRAP_OTRO_PC.md
# Inventario (sin valores): docs/roadmap/INVENTARIO_CLAVES_PLATAFORMAS.md
# =============================================================================

# --- Identidad / máquina ---
METGO_OWNER=miguel.lucero@metgo3d.com
METGO_REPO_ROOT=

# --- API local ---
METGO_API_PORT=8080
METGO_JWT_SECRET=
METGO_PII_KEK=
METGO_API_AUTH_REQUIRED=1
METGO_ALLOW_SELF_REGISTER=0
METGO_ENV=development

# Break-glass (local; en Render van en el panel Environment)
METGO_PASSWORD_ADMIN=
METGO_PASSWORD_USER=
METGO_PASSWORD_METGO=
METGO_PASSWORD_COPIAPO=
METGO_PASSWORD_MANTOS=
METGO_PASSWORD_PAINE=

# --- Render ---
RENDER_API_URL=https://metgo-api.onrender.com
RENDER_STREAMLIT_URL=https://metgo-streamlit.onrender.com
CRON_SECRET=
# Dashboard: https://dashboard.render.com

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=
# service_role solo; nunca en Vue/Pages

# --- WordPress metgo3d.com ---
WP_URL=https://metgo3d.com
WP_USER=
WP_APP_PASSWORD=

# --- SMTP / Formspree ---
METGO_SMTP_HOST=smtp.zoho.com
METGO_SMTP_PORT=587
METGO_SMTP_USER=miguel.lucero@metgo3d.com
METGO_SMTP_PASSWORD=
METGO_NOTIFY_EMAIL=miguel.lucero@metgo3d.com
# Formspree (WP contacto): notificaciones al mismo mail
FORMSPREE_EMAIL=miguel.lucero@metgo3d.com
FORMSPREE_FORM_ID=mjybkaon
FORMSPREE_ENDPOINT=https://formspree.io/f/mjybkaon

# --- Cloudflare Pages (tokens de deploy si usas Wrangler/CI local) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- GitHub ---
# CRON_SECRET debe coincidir con Render (Actions → Secrets)
GITHUB_PAT=

# --- Stripe / Turnstile (opcionales) ---
STRIPE_SECRET_KEY=
METGO_TURNSTILE_SECRET=
METGO_TURNSTILE_SITE_KEY=

# --- cron-job.org ---
# URL recomendada (con wake): ver local/METGO_BOOTSTRAP.local.md
CRONJOB_ORG_URL=
CRONJOB_ORG_TOKEN_QUERY=

# --- URLs públicas SPA (no secretas, útiles al clonar) ---
URL_QUILLOTA=https://metgo-quillota.pages.dev
URL_SPATI=https://metgo-spati.pages.dev
URL_COPIAPO=https://metgo-copiapo.pages.dev
URL_MANTOS=https://metgo-mantos.pages.dev
URL_PAINE=https://metgo-paine.pages.dev
URL_WP=https://metgo3d.com
