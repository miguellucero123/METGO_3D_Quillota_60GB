# Frontend VENTORA — solo vars públicas (Vite). Copiar a .env
# copy .env.example .env

# API METGO (producción Render). En npm run dev el proxy /api ya apunta aquí.
VITE_METGO_API=https://metgo-api.onrender.com/api

# Opcional: Cloudflare Turnstile (registro). Misma site key que en Pages.
# VITE_TURNSTILE_SITE_KEY=

# Opcional: Sentry browser DSN
# VITE_SENTRY_DSN=
