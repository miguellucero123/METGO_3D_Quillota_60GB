# Frontend Izaje Mar (producto API: ventora_mar) — solo vars públicas (Vite).
# NO es VENTORA alta montaña (esa SPA es frontend/spati, producto=ventora).
# copy .env.example .env

# API METGO (producción Render). En npm run dev el proxy /api ya apunta aquí.
VITE_METGO_API=https://metgo-api.onrender.com/api

# Cloudflare Turnstile (registro). Activar cuando METGO_TURNSTILE_* esté en Render.
# Usar la misma site key que en Cloudflare Pages → ventora-izaje-mar.
# VITE_TURNSTILE_SITE_KEY=

# Opcional: Sentry browser DSN
# VITE_SENTRY_DSN=
