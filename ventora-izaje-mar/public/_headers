# Cloudflare Pages — caché + headers seguridad (DT-auth-sec)

/*
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; connect-src 'self' https://metgo-api.onrender.com https://*.pages.dev https://metgo3d.com https://*.metgo3d.com https://challenges.cloudflare.com https://api.open-meteo.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

/limpiar-cache.html
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
