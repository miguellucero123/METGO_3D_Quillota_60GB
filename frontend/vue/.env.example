# Copiar a .env.development (desarrollo) o .env.production (build)
VITE_METGO_API=/api
VITE_API_PORT=8080
# Portal Streamlit para /estado (Render, no streamlit.app)
VITE_METGO_STREAMLIT_RENDER_URL=https://metgo-streamlit.onrender.com
# Mostrar /registro solo si =1 (también requiere METGO_ALLOW_SELF_REGISTER=1 en API)
# VITE_ALLOW_SELF_REGISTER=0
