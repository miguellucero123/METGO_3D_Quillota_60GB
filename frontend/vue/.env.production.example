# Copiar a .env.production antes de `npm run build`
#
# Desarrollo: VITE_METGO_API=/api (proxy Vite → localhost:8080)
# Producción en Vercel: URL pública de la API Flask

# Producción METGO (Render):
VITE_METGO_API=https://metgo-api.onrender.com/api
# Alternativa: proxy en Netlify (_redirects) sin CORS cross-origin:
# VITE_METGO_API=/api
