# Cloudflare Pages — no cachear HTML / SW (evita PWA pegada a builds viejos)
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

/limpiar-cache.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
