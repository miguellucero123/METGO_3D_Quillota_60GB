# ==========================================
# Configuración Backend METGO 3D (FastAPI)
# ==========================================

PROJECT_NAME="METGO 3D"
VERSION="1.0.0"

# ------------------------------------------
# BASE DE DATOS (Supabase PostgreSQL)
# Reemplaza [YOUR-PASSWORD] y [PROJECT-REF] con tus credenciales de Supabase
# Puedes encontrar esta URL en Supabase -> Project Settings -> Database -> Connection string (URI)
# ------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# ------------------------------------------
# SEGURIDAD (JWT)
# ------------------------------------------
# Genera una clave segura, por ejemplo con: openssl rand -hex 32
SECRET_KEY="tu_super_secreto_aqui_cambialo_en_produccion"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS=2

# ------------------------------------------
# EMAILS (SMTP)
# ------------------------------------------
SMTP_SERVER="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@tu-dominio.com"
SMTP_PASSWORD="tu_password_smtp"

# ------------------------------------------
# PAGOS (Stripe) - Opcional para empezar
# ------------------------------------------
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
