# =====================================================================
# METGO 3D - Archivo de Ejemplo de Variables de Entorno (.env.example)
# =====================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a `.env`
# 2. Reemplaza los valores de ejemplo con tus credenciales reales.
# 3. NUNCA subas el archivo `.env` al control de versiones (Git).
# 4. Asegúrate de configurar estas mismas variables en Render / Supabase / Vercel.

# ---------------------------------------------------------------------
# 1. Configuración de la API (Render / Local)
# ---------------------------------------------------------------------
METGO_ENV=development                   # development, staging, production
PORT=8080                               # Puerto usado por Render/Railway (o local)
METGO_API_HOST=0.0.0.0                  # Host de la API Flask
METGO_API_DEBUG=1                       # 1 para modo debug, 0 para producción
METGO_API_AUTH_REQUIRED=1               # 1 para requerir JWT, 0 para desactivar auth (cuidado)
METGO_CORS_ORIGINS=*                    # Orígenes permitidos (separados por coma, o * para todos)

# ---------------------------------------------------------------------
# 2. Seguridad y Autenticación (JWT & API Keys)
# ---------------------------------------------------------------------
METGO_JWT_SECRET=super_secret_jwt_key_example
METGO_JWT_EXPIRATION_HOURS=2            # Reducido a 2h por seguridad
METGO_JWT_ALGORITHM=HS256
METGO_PII_KEK=key_encryption_key_example # Para cifrado de datos sensibles en reposo
METGO_ALLOW_SELF_REGISTER=0             # 1 para permitir auto-registro (normalmente 0 en B2B)
METGO_SESSION_IDLE_S=1800               # Cierre de sesión inactivo por Ley 21.719 (30 mins)

# ---------------------------------------------------------------------
# 3. Base de Datos (Supabase)
# ---------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key                # Anon Key (para frontend / lecturas básicas)
SUPABASE_SERVICE_ROLE_KEY=tu-service-key # Service Role Key (para backend admin)

# ---------------------------------------------------------------------
# 4. Caché y Rate Limiting (Redis)
# ---------------------------------------------------------------------
REDIS_URL=redis://localhost:6379        # URL de conexión a Redis (Upstash o local)
REDIS_PASSWORD=opcional                 # Contraseña de Redis si aplica

# ---------------------------------------------------------------------
# 5. APIs Externas (Meteorología, Pagos, Mapas)
# ---------------------------------------------------------------------
OPENWEATHER_API_KEY=tu_api_key_aqui
NASA_API_KEY=tu_api_key_aqui
GOOGLE_MAPS_API_KEY=tu_api_key_aqui
STRIPE_SECRET_KEY=sk_test_CHANGE_ME     # Placeholder; valor real solo en Render / .env local

# ---------------------------------------------------------------------
# 6. Observabilidad, Correos y Background Jobs
# ---------------------------------------------------------------------
METGO_SENTRY_DSN=https://example@sentry.io/123 # Tracking de errores
METGO_SMTP_HOST=smtp.gmail.com
METGO_SMTP_FROM=alertas@metgo3d.com
CRON_SECRET=secreto_para_endpoints_etl  # Token para autorizar llamadas de ETL nocturno

# ---------------------------------------------------------------------
# 7. Flags y Configuraciones Específicas del Proyecto
# ---------------------------------------------------------------------
METGO_ML_AUTO_TRAIN=0                   # 1 para entrenar modelos ML al iniciar la API
METGO_SITIO_DEFAULT=quillota            # Sitio por defecto (quillota, paine, copiapo)
METGO_OPENMETEO_TIMEOUT=25              # Segundos de timeout para OpenMeteo
METGO_OPENMETEO_RETRIES=3               # Reintentos si falla OpenMeteo
METGO_CACHE_LASTGOOD_MAX_AGE=172800     # Edad máxima de caché (48 horas en segundos)
