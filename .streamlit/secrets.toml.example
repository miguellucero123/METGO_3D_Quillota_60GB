# Archivo de configuración de secretos para Streamlit Cloud
# Copia este archivo como .streamlit/secrets.toml y configura tus valores

[general]
# Configuración general del sistema
app_name = "Dashboard METGO Quillota"
version = "1.0.0"
environment = "production"

[database]
# Configuración de base de datos (opcional)
host = "localhost"
port = 5432
username = "metgo_user"
password = "your_password_here"
database = "metgo_db"

[api_keys]
# Claves de API para servicios externos (opcional)
openweather_api = "your_openweather_api_key"
google_maps_api = "your_google_maps_api_key"

[email]
# Configuración de email para notificaciones (opcional)
smtp_server = "smtp.gmail.com"
smtp_port = 587
username = "your_email@gmail.com"
password = "your_app_password"

[monitoring]
# Configuración de monitoreo
log_level = "INFO"
enable_metrics = true
alert_threshold = 80
