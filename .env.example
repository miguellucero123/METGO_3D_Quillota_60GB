# Credenciales METGO (Streamlit + API JWT)
METGO_PASSWORD_ADMIN=cambiar_admin
METGO_PASSWORD_USER=cambiar_user
METGO_PASSWORD_METGO=cambiar_metgo
METGO_PASSWORD_AGRONOMO=cambiar_agronomo
METGO_PASSWORD_OPERADOR=cambiar_operador
METGO_PASSWORD_LECTOR=cambiar_lector
METGO_PASSWORD_COPIAPO=cambiar_copiapo
METGO_PASSWORD_MANTOS=cambiar_mantos
METGO_PASSWORD_PAINE=cambiar_paine

# Auth endurecido (producción)
# En Render: METGO_ENV=production (o confiar en RENDER=true)
# METGO_ENV=production
# Auto-registro: off por defecto. Solo local/demo con =1
METGO_ALLOW_SELF_REGISTER=0

# JWT (API REST)
METGO_JWT_SECRET=generar-secreto-largo-aleatorio
METGO_JWT_EXPIRATION_SECONDS=3600
METGO_API_AUTH_REQUIRED=1
METGO_API_PORT=8080
# Alternativa si 8080 ocupado: METGO_API_PORT=9090
# En frontend_vue/.env.development use VITE_API_PORT=9090 con el mismo valor
METGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,https://metgo3d.com,https://www.metgo3d.com,https://metgo-quillota.pages.dev,https://metgo-spati.pages.dev,https://metgo-copiapo.pages.dev,https://metgo-mantos.pages.dev,https://metgo-paine.pages.dev,https://metgo3d.netlify.app,https://metgo-paine.netlify.app
# Visor iframe (local Vue /puertos): usar Render, no streamlit.app
METGO_STREAMLIT_RENDER_URL=https://metgo-streamlit.onrender.com
# METGO_STREAMLIT_CLOUD_URL=https://metgo-streamlit.onrender.com
# Enlace público Streamlit Cloud (solo abrir en pestaña, no iframe)
# METGO_STREAMLIT_PUBLIC_URL=https://metgo-3d-quillota-60gb.streamlit.app

# Fase 6 — ETL nocturno (módulo 08 → SQLite datos_runtime)
# METGO_ETL_DIAS_SYNC=30
# No importar CSV estático 5 años (más rápido en cron): 1/true
# METGO_ETL_SKIP_CSV=0

# Fase 7 — Adaptador MQTT (módulo 03; sin broker usa REST + inbox JSON)
# METGO_MQTT_ENABLED=0
# METGO_MQTT_HOST=broker.ejemplo.local
# METGO_MQTT_PORT=1883
# METGO_MQTT_TOPIC=metgo/+/+
# METGO_MQTT_CLIENT_ID=metgo-api
# METGO_MQTT_USER=
# METGO_MQTT_PASSWORD=
# METGO_MQTT_INBOX_INTERVAL=15
# TLS (puerto por defecto 8883): METGO_MQTT_TLS=1
# METGO_MQTT_TLS_INSECURE=0
# METGO_MQTT_CA_CERT=ruta/a/ca.pem

# Fase 10 — Métricas Prometheus y ML profundo
# METGO_METRICS_PUBLIC=1
# METGO_ML_DEEP_TIMEOUT=300
# Worker aparte: backend/10_Deployment_Produccion/scripts/mqtt_listener.bat
# Inbox: backend/08_Gestion_Datos/datos_runtime/mqtt_inbox/*.json
# Formato: {"topic":"metgo/quillota/temperatura","payload":{"valor":18.5}}

# Circuit breaker SINCA + cola reintento ETL
# M8: CSV observado (AWS/SINCA export) — slug = rajo (paipote, mb_rajo, escondida_rajo, …)
# METGO_SINCA_CSV_DIR=D:/ruta/sinca
# METGO_SINCA_CSV_URL=https://ejemplo/sinca/{slug}.csv
# METGO_SINCA_IDS={"paipote":"CODIGO_MMA"}
# METGO_SINCA_CB_FALLAS=3
# METGO_SINCA_CB_COOLDOWN_S=900
# METGO_ETL_RETRY_MAX=8
# METGO_ETL_RETRY_ATTEMPTS=5

# Correo corporativo METGO (alertas y notificaciones)
METGO_NOTIFY_EMAIL=miguel.lucero@metgo3d.com
# Reintento outbox: backend/08_Gestion_Datos/scripts/run_notificaciones_outbox_retry.py
#
# Zoho Mail: el plan Forever Free NO expone SMTP a apps externas (solo web/app Zoho).
# Para usar SMTP desde METGO necesitas Mail Lite (~USD 1/usuario/mes) o superior.
# Con plan de pago, en Zoho: Settings → Mail Accounts → activar IMAP (habilita SMTP).
# Si usas 2FA: accounts.zoho.com → Seguridad → Contraseñas de aplicación.
#
# METGO_SMTP_HOST=smtp.zoho.com
# METGO_SMTP_PORT=587
# METGO_SMTP_TLS=1
# METGO_SMTP_USER=miguel.lucero@metgo3d.com
# METGO_SMTP_PASSWORD=contraseña_o_app_password_zoho
# METGO_SMTP_FROM=miguel.lucero@metgo3d.com
#
# Checklist ops SMTP (E10/F):
# 1) Plan Zoho con SMTP o ZeptoMail/Resend
# 2) Pegar METGO_SMTP_* en Render Environment
# 3) Probar POST alerta o script run_notificaciones_outbox_retry.py
#
# Alternativa sin subir plan de buzón: Zoho ZeptoMail (API transaccional, otro producto)
# o servicios como Resend/SendGrid (requieren integración API, no solo .env SMTP).
#
# Sin METGO_SMTP_*: los avisos se guardan en
# backend/08_Gestion_Datos/datos_runtime/notificaciones_outbox.jsonl

# Supabase (Meteo Store)
SUPABASE_URL=tu_supabase_url
SUPABASE_KEY=tu_supabase_key

# WordPress.com REST (solo local; Application Password — nunca en git)
# WP_URL=https://metgo3d.com
# WP_USER=tu_usuario_wp
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Uso: python scripts/wp_rest.py list

# ---------------------------------------------------------
# VARIABLES ADICIONALES (Detectadas en auditoría DT-2)
# ---------------------------------------------------------

# Umbrales
# METGO_NIEVE_UMBRAL_FACTOR=1

# Seguridad y Anti-Abuso (Hardening)
# METGO_RATE_LIMIT_ENABLED=1
# METGO_TURNSTILE_SECRET=tu_turnstile_secret
# METGO_TURNSTILE_SITE_KEY=tu_turnstile_site_key
# METGO_TURNSTILE_REQUIRED=0
# METGO_REQUIRE_EMAIL_VERIFY=1

# Multi-Tenant y Sitios
# METGO_TENANT_DEFAULT=quillota
# METGO_SITIO_DEFAULT=quillota
# METGO_USER_SITIO_JSON={"user1":"quillota"}

# Caché OpenMeteo global (segundos). Default 3600 = 1 h. Para 30 min: 1800
# METGO_OPENMETEO_CACHE_TTL=3600
# Ciclo 00/12 UTC (default): descargas de pronóstico/mapas solo en cron 00 y 12.
# METGO_OPENMETEO_FETCH_MODE=ciclo
# Para refresco por TTL horario: METGO_OPENMETEO_FETCH_MODE=ttl
# METGO_OPENMETEO_TIMEOUT=8
# METGO_OPENMETEO_RETRIES=2
# METGO_OPENMETEO_COOLDOWN=120

# Streamlit Local Config
# METGO_STREAMLIT_LOCAL_ONLY=0

# SPATI (Alertas y NWP)
# CRON_SECRET=secreto_cron
# METGO_SPATI_UMBRALES_JSON=
# METGO_SPATI_ALERT_EMAIL=
# METGO_SPATI_ALERT_WEBHOOK=
# METGO_SPATI_NWP_TIMEOUT=12
# METGO_SPATI_NWP_RETRIES=2
# Si no se define, hereda METGO_OPENMETEO_CACHE_TTL (1 h)
# METGO_SPATI_NWP_CACHE_TTL=3600
# METGO_SPATI_ALLOW_SYNTHETIC=1

# SINCA / Calidad del Aire
# METGO_SINCA_USE_EJEMPLOS=1

# Pagos (Stripe)
# STRIPE_PRICE_PRO=price_pro_mock_123
# STRIPE_PRICE_FAENA=price_faena_mock_456
# STRIPE_WEBHOOK_SECRET=

# Paquete Ambiental y Caché (hereda METGO_OPENMETEO_CACHE_TTL si no se setea)
# METGO_PAQUETE_ALLOW_DEGRADED=1
# METGO_PAQUETE_CACHE_TTL=3600
# METGO_CACHE_LASTGOOD_MAX_AGE=172800

# Ops Board (Panel Operativo)
# METGO_OPS_BOARD_MAX=24
# METGO_OPS_BOARD_LIVE=24

# Supabase Alternativas (Opcional)
# METGO_SUPABASE_KEY=
# SUPABASE_ANON_KEY=
# VITE_SUPABASE_URL=
