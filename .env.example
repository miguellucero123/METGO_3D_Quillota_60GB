# METGO_3D – Variables de entorno
# Copia este archivo como .env y reemplaza los valores antes de ejecutar en producción.
# NUNCA commitas el archivo .env al repositorio.
#
#   cp .env.example .env

# --- Credenciales de acceso al dashboard ---
# Contraseña para el usuario "admin"
METGO_PASSWORD_ADMIN=cambiar_en_produccion

# Contraseña para el usuario "user"
METGO_PASSWORD_USER=cambiar_en_produccion

# Contraseña para el usuario "metgo"
METGO_PASSWORD_METGO=cambiar_en_produccion
